<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>QCY H3 托盘控制工具</AssemblyTitle>
    <Product>QcyH3Tray</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 应用图标同时作为窗口 Icon（AppIconSource 经 pack URI 加载；ico 由 tools/IconGen 生成） -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\headphones_3d.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QcyH3Tray.Core\QcyH3Tray.Core.csproj" />
  </ItemGroup>

</Project>
