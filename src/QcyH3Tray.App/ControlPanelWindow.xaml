<Window x:Class="QcyH3Tray.App.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QCY H3"
        Width="410"
        SizeToContent="Height"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="OnDeactivated"
        SourceInitialized="OnSourceInitialized"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
      托盘快捷面板（阶段 3a 重构，plan.md P1-1 #2；2026-10-31 玻璃拟态改造）：
      头部状态 → 降级横幅（唯一场景）→ 3D 耳机展示位（资源缺失自动折叠）→ 电量
      （validity 映射）→ 噪声控制（四段 + 等级/场景子行）→ 均衡器 chips（等宽两行）
      → 游戏模式 → 页脚（控制中心 / 设置）。
      机制保持不变：无边框 + Topmost + 不进任务栏 + Deactivated 收起复用；
      窗口级 UseLayoutRounding / SnapsToDevicePixels / Ideal + ClearType（D2 根治之三）。
      玻璃拟态：AllowsTransparency（分层窗口）与 DWM SystemBackdrop 不兼容，改用
      WindowChrome（GlassFrameThickness=-1 全窗扩展帧）+ Background=Transparent，
      透明区域透出系统 Acrylic（BackdropService，Transient 档）；Root 外沿 8px 透明
      边距即原阴影区，玻璃卡片半透明填充 + Glass.Border 发丝描边 + 极轻阴影。
      WindowChrome CaptionHeight=0 / ResizeBorderThickness=0：无标题拖拽、保持
      NoResize 语义，内容区照常接收鼠标（命中测试不变）。
    -->
    <shell:WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <!-- Shadow is drawn on a separate empty visual to retain sharp text. -->
    <Grid>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift"/>
        </Grid.RenderTransform>
        <Border Margin="18"
                CornerRadius="{StaticResource CornerRadius/Card}"
                Background="#D9FFFFFF"
                Effect="{StaticResource Effect/Glass.ShellElevation}"
                IsHitTestVisible="False"/>
        <Border x:Name="RootCard"
                Margin="18"
                Background="{StaticResource Brush/Glass.Shell}"
                BorderBrush="{StaticResource Brush/Glass.Edge}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius/Card}"
                Padding="18"
                TextElement.FontFamily="{StaticResource Font/Primary}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      PanningMode="VerticalOnly">
          <StackPanel>

            <!-- 1. 头部：设备名 + 九态状态文字（非 Connected 态附 ↻ 立即重连） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QCY H3"
                               FontSize="{StaticResource Font/Size.Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush/Text.Primary}"/>
                    <TextBlock Text="无线耳机 · 快捷控制"
                               FontSize="{StaticResource Font/Size.Caption}"
                               Foreground="{StaticResource Brush/Text.Tertiary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="未连接"
                               FontSize="{StaticResource Font/Size.Caption}"
                               LineHeight="{StaticResource Font/Line.Caption}"
                               Foreground="{StaticResource Brush/Text.Tertiary}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButton}"
                            Margin="{StaticResource Spacing/Gap}"
                            ToolTip="立即重连"
                            Visibility="Collapsed"
                            Click="OnRefreshClick">
                        <TextBlock FontFamily="{StaticResource Font/Icon}" Text="&#xE72C;"
                                   FontSize="{StaticResource Font/Size.Body}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 降级横幅（唯一场景：Core 状态机 Degraded 相——连接态下命令连续失败） -->
            <Border x:Name="ErrorBanner"
                    Style="{StaticResource Banner}"
                    Margin="{StaticResource Spacing/Block.Small}"
                    Visibility="Collapsed">
                <TextBlock Text="耳机无响应，正在重试"
                           LineHeight="{StaticResource Font/Line.Caption}"/>
            </Border>

            <!-- 3. 3D 耳机展示位：AppImage/HeadphoneHero 资源存在则显示，
                 不存在（当前阶段 5 未放入矢量渲染图）整块折叠为 0 高，不放占位位图 -->
            <Border x:Name="HeadphoneHero"
                    Height="{StaticResource Size/Hero.Height}"
                    Margin="{StaticResource Spacing/Block}"
                    CornerRadius="{StaticResource CornerRadius/Card}"
                    Background="{StaticResource Brush/Glass.FloatingSurface}"
                    BorderBrush="{StaticResource Brush/Glass.Edge}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Effect="{StaticResource Effect/Glass.CardElevation}"
                    Visibility="Collapsed">
                <Grid>
                    <Image x:Name="HeadphoneHeroImage"
                           Stretch="Uniform"
                           Margin="12,0"
                           MaxHeight="{StaticResource Size/Hero.Height}"/>
                    <TextBlock Text="QCY H3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="14,0,0,12"
                               FontSize="{StaticResource Font/Size.Caption}"
                               Foreground="{StaticResource Brush/Text.Tertiary}"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 4. 电量：标签 + validity 小字 + 大号百分比 -->
            <Border Style="{StaticResource GlassFloatingCard}" Margin="{StaticResource Spacing/Block}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="电量" Style="{StaticResource SectionLabel}" Margin="0"/>
                <TextBlock x:Name="BatteryStateCaption"
                           Grid.Column="1"
                           Text="已连接"
                           FontSize="{StaticResource Font/Size.Caption}"
                           LineHeight="{StaticResource Font/Line.Caption}"
                           Foreground="{StaticResource Brush/Success}"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryTextBlock"
                           Grid.Row="1"
                           Text="--"
                           FontSize="{StaticResource Font/Size.Display}"
                           LineHeight="{StaticResource Font/Line.Display}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush/Text.Primary}"/>
            </Grid>
            </Border>

            <!-- 5. 噪声控制：四段分段（选中滑块动画在代码层）+ 等级/场景子行 -->
            <Border Style="{StaticResource GlassFloatingCard}" Margin="{StaticResource Spacing/Block}">
              <StackPanel x:Name="NoiseSection">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <!-- validity≠Available 或非连接态：禁用并降透明度 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="噪声控制" Style="{StaticResource SectionLabel}"/>
                <Border Height="{StaticResource Size/Segment.TrackHeight}"
                        CornerRadius="{StaticResource CornerRadius/Control}"
                        Background="{StaticResource Brush/Segment.Track}"
                        ClipToBounds="True">
                    <Grid>
                        <Border x:Name="NoiseThumb"
                                Width="56"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Margin="{StaticResource Spacing/Segment.ThumbInset}"
                                CornerRadius="{StaticResource CornerRadius/Small}"
                                Background="{StaticResource Brush/Segment.Thumb}"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NoiseThumbShift"/>
                            </Border.RenderTransform>
                        </Border>
                        <Grid x:Name="NoiseSegmentGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="SegOff"
                                         Style="{StaticResource SegmentRadioButton}"
                                         GroupName="noiseSegment"
                                         Content="关闭"
                                         Checked="OnSegmentChecked"/>
                            <RadioButton x:Name="SegTransparency"
                                         Grid.Column="1"
                                         Style="{StaticResource SegmentRadioButton}"
                                         GroupName="noiseSegment"
                                         Content="通透"
                                         Checked="OnSegmentChecked"/>
                            <RadioButton x:Name="SegNoiseCancelling"
                                         Grid.Column="2"
                                         Style="{StaticResource SegmentRadioButton}"
                                         GroupName="noiseSegment"
                                         Content="降噪"
                                         Checked="OnSegmentChecked"/>
                            <RadioButton x:Name="SegAdaptive"
                                         Grid.Column="3"
                                         Style="{StaticResource SegmentRadioButton}"
                                         GroupName="noiseSegment"
                                         Content="自适应"
                                         Checked="OnSegmentChecked"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 5b. 降噪子行：等级（低/中/高）+ 场景（通勤/室内/抗风） -->
                <!-- Separate level and scene into labeled rows: no more six cramped chips on one line. -->
                <StackPanel x:Name="NoiseSubRow"
                            Margin="{StaticResource Spacing/Block.Small}"
                            Visibility="Collapsed">
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="降噪等级"
                                   Foreground="{StaticResource Brush/Text.Tertiary}"
                                   FontSize="{StaticResource Font/Size.Caption}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="LevelLow"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseLevel" Content="低" Checked="OnLevelChecked"/>
                            <RadioButton x:Name="LevelMedium"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseLevel" Content="中"
                                         Margin="{StaticResource Spacing/Gap}" Checked="OnLevelChecked"/>
                            <RadioButton x:Name="LevelHigh"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseLevel" Content="高"
                                         Margin="{StaticResource Spacing/Gap}" Checked="OnLevelChecked"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="降噪场景"
                                   Foreground="{StaticResource Brush/Text.Tertiary}"
                                   FontSize="{StaticResource Font/Size.Caption}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="SceneCommuting"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseScene" Content="通勤" Checked="OnSceneChecked"/>
                            <RadioButton x:Name="SceneIndoor"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseScene" Content="室内"
                                         Margin="{StaticResource Spacing/Gap}" Checked="OnSceneChecked"/>
                            <RadioButton x:Name="SceneAntiWind"
                                         Style="{StaticResource PresetChipSmall}"
                                         GroupName="noiseScene" Content="抗风"
                                         Margin="{StaticResource Spacing/Gap}" Checked="OnSceneChecked"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            </Border>

            <!-- 6. 均衡器：等宽 chips 两行（4+3）；自定义 = 打开 EQ 编辑窗（3b 重做窗口本身） -->
            <Border Style="{StaticResource GlassFloatingCard}" Margin="{StaticResource Spacing/Block}">
              <StackPanel>
                <TextBlock Text="均衡器" Style="{StaticResource SectionLabel}"/>
                <WrapPanel x:Name="EqChipsPanel" ItemWidth="{StaticResource Size/EqChip.Width}">
                    <WrapPanel.Style>
                        <Style TargetType="{x:Type WrapPanel}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <RadioButton x:Name="EqPresetDefault"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="默认"
                                 Tag="1"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqPresetPop"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="流行"
                                 Tag="2"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqPresetHeavyBass"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="重低音"
                                 Tag="3"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqPresetRock"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="摇滚"
                                 Tag="4"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqPresetSoft"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="柔和"
                                 Tag="5"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqPresetClassic"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="古典"
                                 Tag="6"
                                 Checked="OnEqPresetChecked"/>
                    <RadioButton x:Name="EqCustomChip"
                                 Style="{StaticResource PresetChip}"
                                 GroupName="eqPreset"
                                 Content="自定义"
                                 Checked="OnEqCustomChecked"/>
                </WrapPanel>
            </StackPanel>
            </Border>

            <!-- 7. 游戏模式：行 + 开关（validity≠Available 禁用并降透明度） -->
            <Border Style="{StaticResource GlassFloatingCard}" Margin="{StaticResource Spacing/Block}">
              <Grid x:Name="GameModeRow">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="游戏模式"
                           FontSize="{StaticResource Font/Size.Body}"
                           Foreground="{StaticResource Brush/Text.Primary}"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="GameModeSwitch"
                              Style="{StaticResource SwitchToggleButton}"
                              HorizontalAlignment="Right"
                              Checked="OnGameModeChanged"
                              Unchecked="OnGameModeChanged"/>
            </Grid>
            </Border>

            <!-- 8. 页脚：控制中心（3b 创建窗口，当前点击提示开发中）+ 设置齿轮（菜单保留） -->
            <Border Style="{StaticResource GlassFloatingCard}" Margin="{StaticResource Spacing/Block}" Padding="10,8">
              <Grid>
                <Button x:Name="ControlCenterButton"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Left"
                        ToolTip="打开完整控制中心"
                        Click="OnControlCenterClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Font/Icon}" Text="&#xE80F;"
                                   FontSize="{StaticResource Font/Size.Body}" VerticalAlignment="Center"/>
                        <TextBlock Text="控制中心"
                                   FontSize="{StaticResource Font/Size.Caption}"
                                   Margin="{StaticResource Spacing/Gap}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        ToolTip="设置"
                        Click="OnSettingsClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="AutostartMenuItem"
                                      Header="开机自启"
                                      IsCheckable="True"
                                      Click="OnAutostartToggleClick"/>
                            <MenuItem Header="关于" Click="OnAboutClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Font/Icon}" Text="&#xE713;"
                                   FontSize="{StaticResource Font/Size.Body}" VerticalAlignment="Center"/>
                        <TextBlock Text="设置"
                                   FontSize="{StaticResource Font/Size.Caption}"
                                   Margin="{StaticResource Spacing/Gap}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            </Border>

          </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Window>
