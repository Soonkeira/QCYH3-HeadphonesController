<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
      ══════════════════════════════════════════════════════════════════
      基础控件模板（阶段 3a，plan.md P1-1 #1 / P0-2 #1）。
      规则：
      - 一切颜色 / 度量只引用 Tokens.xaml（App.xaml 中先于本文件合并），零硬编码；
      - 全部交互模板覆盖 Normal / Hover / Pressed / Checked / Disabled；
      - Checked 深底上一律白字（ContentPresenter 显式 TextElement.Foreground）；
      - 禁止负 margin（D2 根治）：文字用 VerticalAlignment=Center + MinHeight + Padding 语义化；
      - 文字渲染走窗口级 Ideal + ClearType + UseLayoutRounding（见 ControlPanelWindow）。
      ══════════════════════════════════════════════════════════════════
    -->

    <!--
      隐式 TextBlock：全局 CJK 安全字族（D2 根治之二——DevicePicker/EqDetail 等
      未改造窗口同样受益）。TextBlock 的隐式样式可穿越模板边界，chips 内的
      自动生成 TextBlock 亦被覆盖。
    -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Floating cards used in both windows. They are translucent; the actual
         backdrop blur is provided at the HWND level by BackdropService. -->
    <Style x:Key="GlassFloatingCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush/Glass.FloatingSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush/Glass.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius/Card}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Card.Padding}"/>
        <Setter Property="Effect" Value="{StaticResource Effect/Glass.CardElevation}"/>
    </Style>

    <!--
      ═══════════════ 悬浮手感（hover lift）共享资源 ═══════════════
      约定（性能纪律）：
      - Effect/Lift 只在 Hover/Checked 期间由 Trigger 挂载（Setter Effect），进出即
        挂载/卸载，不得常驻在按钮模板上（免全局位图效果开销）；Disabled 一律卸载；
      - 各模板声明 x:Name="Lift" 的 TranslateTransform：Hover 进出以 150ms 动画在
        Y=-1 / Y=0 间过渡，Pressed 回落 Y=0——"浮起-按下"手感；
      - 适用：chips / 分段单段 / IconButton / AccentButton / SecondaryButton。
        开关与滑块不加 lift（已有位移动画）；分段单段只做位移不加阴影——其宿主
        分段轨道 ClipToBounds 会把阴影裁出硬边。
    -->
    <DropShadowEffect x:Key="Effect/Lift"
                      po:Freeze="True"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.14"/>

    <!-- ═══════════════ 小节标签（电量 / 噪声控制 / 均衡器） ═══════════════ -->
    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Text.Tertiary}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing/Label.Below}"/>
    </Style>

    <!-- ═══════════════ 幽灵小按钮（↻ 重连 / ⚙ 设置 / 控制中心） ═══════════════ -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Ghost.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/IconButton.Padding}"/>
        <Setter Property="MinWidth" Value="{StaticResource Size/IconButton.MinSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/IconButton.MinSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius/Small}"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 顺序即优先级：Disabled 最后覆盖 Hover/Pressed；Checked 兜底（本模板无 Checked） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Ghost.Background.Hover}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Ghost.Foreground.Hover}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect/Lift}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Ghost.Background.Pressed}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Ghost.Foreground.Hover}"/>
                            <!-- 按下回落：阴影收敛 + 归位（悬停态仍在则松开后再浮起） -->
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Ghost.Foreground.Disabled}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ 降级横幅（Danger 浅底；唯一用途：Degraded 相） ═══════════════ -->
    <Style x:Key="Banner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush/Banner.Danger.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush/Banner.Danger.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius/Small}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Banner.Padding}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush/Banner.Danger.Foreground}"/>
        <Setter Property="TextElement.FontSize" Value="{StaticResource Font/Size.Caption}"/>
    </Style>

    <!--
      ═══════════════ 窗体标准按钮（阶段 3b：控制中心 / EQ 编辑器） ═══════════════
      主操作（AccentButton）与次操作（SecondaryButton）；全部状态覆盖，颜色只取 Tokens。
    -->
    <Style x:Key="AccentButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Brush/Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Button.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Button.MinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadius/Control}"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Accent.Hover}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect/Lift}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Accent.Pressed}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Chip.Background.Disabled}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Text.Disabled}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Brush/Glass.Control}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Button.Padding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Button.MinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush/Glass.Edge}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius/Control}"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Glass.ControlHover}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Effect/Lift}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Surface.Pressed}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Border.Subtle}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Text.Disabled}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表单文本框（EQ 配置命名等） -->
    <Style x:Key="FormTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource Brush/Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush/Border.Subtle}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Chip.Padding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Button.MinHeight}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush/Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush/Surface.Subtle}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush/Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      ═══════════════ 噪声四段分段控件的单段 ═══════════════
      段本身透明；选中滑块（Brush/Segment.Thumb 主色）由窗口代码在容器层绘制并动画。
      状态覆盖：Normal 次级字 / Hover 主字 / Pressed 主字 / Checked 白字（深底保证）/
      Disabled 禁用字 + 箭头光标。
      悬浮手感：单段仅做 Y=-1 位移（不挂阴影——宿主分段轨道 ClipToBounds 会把
      光晕裁出硬边）；Disabled 无 lift。
    -->
    <Style x:Key="SegmentRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush/Segment.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Segment.MinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border Background="Transparent">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Segment.Foreground.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Segment.Foreground.Hover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Segment.Foreground.Hover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"
                                                         To="-1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Checked 最后声明：覆盖 Hover/Pressed（选中白字不随悬停变暗） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Segment.Foreground.Checked}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ═══════════════ 圆角 chip（EQ 预设；CornerRadius/Chip=8 圆角方框） ═══════════════
      选中 = Accent 实底白字（透明度过渡动画）。D2 根治：无负 margin、
      MinHeight ≥ 30、垂直 Padding ≥ 6、MinWidth 保证三字中文不换行。
      状态覆盖：Normal / Hover / Pressed / Checked / Disabled。
      结构规则（根治"选中蓝底只盖住文字区"缺陷）：
      - Root 不挂 Padding——装饰层必须与 Root 等大，才能铺满整颗方框；
      - Padding 移交内容层（ContentPresenter Margin），布局度量与此前完全一致；
      - Normal/Hover/Pressed/Disabled 仍切换 Root.Background（元素自身的背景
        本来就覆盖 Padding 环，无此问题）；Checked 走全尺寸 Overlay 淡入，
        Opacity=1 时整颗方框为 Accent 实底，悬停背景被完全盖住（Checked 优先）。
      悬浮手感：Hover 浮起（Y=-1，150ms）+ Effect/Lift 阴影；Pressed 回落并收敛
        阴影；Checked 期间阴影保持（Trigger 声明在最后故优先）；Disabled 无 lift。
    -->
    <Style x:Key="PresetChip" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="{StaticResource Brush/Glass.Control}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush/Chip.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Chip.MinHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource Size/Chip.MinWidth}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Chip.Padding}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing/Chip}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <!-- Shadow sits behind the actual control so the text stays sharp. -->
                    <Grid x:Name="Surface" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Lift"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Shadow"
                                Background="#D9FFFFFF"
                                CornerRadius="{StaticResource CornerRadius/Chip}"
                                Effect="{StaticResource Effect/Glass.ControlRest}"
                                IsHitTestVisible="False"/>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush/Glass.ControlEdge}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius/Chip}">
                            <ContentPresenter x:Name="Content"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Glass.ControlHover}"/>
                            <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource Effect/Glass.ControlHover}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Chip.Foreground.Hover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="0:0:0.17"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.17"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Surface.Pressed}"/>
                            <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource Effect/Glass.ControlRest}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.09"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Full-width, full-height blue pill: NEVER a label-only overlay. -->
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Chip.Background.Checked}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Chip.Background.Checked}"/>
                            <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource Effect/Glass.ControlSelected}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Chip.Foreground.Checked}"/>
                        </Trigger>
                        <!-- Keyboard focus should be visible but never override the checked fill. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Accent}"/>
                        </Trigger>
                        <!-- The last trigger wins when the device data makes this disabled. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Chip.Background.Disabled}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Glass.ControlEdge}"/>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Chip.Foreground.Disabled}"/>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ═══════════════ 小号 chip（降噪等级 低/中/高 与场景 通勤/室内/抗风） ═══════════════
    -->
    <Style x:Key="PresetChipSmall" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource PresetChip}">
        <Setter Property="FontSize" Value="{StaticResource Font/Size.Caption}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size/Chip.Small.MinHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource Size/Chip.Small.MinWidth}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing/Chip.Small.Padding}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing/Chip.Horizontal}"/>
    </Style>

    <!--
      ═══════════════ 游戏模式开关（36×20 轨道 + 14×14 白色圆钮，滑动动画） ═══════════════
      状态覆盖：Normal（灰轨）/ Checked（主色轨，150ms 色彩+位移动画）/
      Disabled（禁用灰轨 + 箭头光标）/ Hover 与 Pressed（轨迹色加深一档）。
    -->
    <Style x:Key="SwitchToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="{StaticResource Size/Switch.Width}"/>
        <Setter Property="Height" Value="{StaticResource Size/Switch.Height}"/>
        <Setter Property="Background" Value="{StaticResource Brush/Switch.Track.Off}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadius/Switch}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="{StaticResource Size/Switch.Thumb}"
                                 Height="{StaticResource Size/Switch.Thumb}"
                                 Fill="{StaticResource Brush/Switch.Thumb}"
                                 HorizontalAlignment="Left"
                                 Margin="{StaticResource Spacing/Switch.ThumbInset}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush/Switch.Track.On}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush/Switch.Track.On}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush/Switch.Track.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Color/Switch.Track.On}" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size/Switch.Travel}" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Color/Switch.Track.Off}" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ EQ 编辑器滑杆（自制极简轨道 + 圆形拇指；EqEditorWindow 使用） ═══════════════ -->
    <Style x:Key="SliderInvisibleRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRoundThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Width="18" Height="18" Fill="{StaticResource Brush/Accent}" Stroke="{StaticResource Brush/Surface.Card}" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 竖向（七段 EQ）：轨道为 4px 竖线 -->
    <Style x:Key="EqSliderVertical" TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent">
                        <Border Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                Background="{StaticResource Brush/Border.Subtle}"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Style="{StaticResource SliderInvisibleRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Style="{StaticResource SliderInvisibleRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderRoundThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向（总增益）：轨道为 4px 横线 -->
    <Style x:Key="EqSliderHorizontal" TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent" Height="18">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource Brush/Border.Subtle}"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Style="{StaticResource SliderInvisibleRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Style="{StaticResource SliderInvisibleRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderRoundThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
