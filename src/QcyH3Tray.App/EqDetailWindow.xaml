<Window x:Class="QcyH3Tray.App.EqDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="均衡器 · 自定义"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#FFFFFF">
    <StackPanel Margin="18">

        <!-- 总增益 masterGain（-12.0 ~ +12.0 dB，0.5 步进） -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="总增益"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="MasterGainTextBlock"
                       Text="0.0 dB"
                       FontSize="12"
                       Foreground="#4D4D4D"
                       HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="MasterGainSlider"
                Style="{StaticResource EqSliderHorizontal}"
                Minimum="-12" Maximum="12"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                ValueChanged="OnGainSliderValueChanged"/>

        <!-- 七段竖向滑块（55/220/500/1000/1800/2800/7500 Hz）在代码里生成 -->
        <UniformGrid x:Name="BandGrid" Columns="7" Margin="0,16,0,0"/>

        <!-- 操作行 -->
        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="HintTextBlock"
                       Text=""
                       FontSize="11"
                       Foreground="#8A8A8A"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"
                       HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReadButton" Content="读自耳机" MinWidth="72" Click="OnReadClick"/>
                <Button x:Name="ResetButton" Content="重置" MinWidth="56" Margin="8,0,0,0" Click="OnResetClick"/>
                <Button x:Name="ApplyButton" Content="应用到耳机" MinWidth="84" Margin="8,0,0,0" Click="OnApplyClick"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
