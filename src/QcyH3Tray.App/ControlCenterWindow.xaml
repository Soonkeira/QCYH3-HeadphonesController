<Window x:Class="QcyH3Tray.App.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QCY H3 控制中心"
        Width="960"
        Height="680"
        MinWidth="830"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="OnSourceInitialized">
    <!--
      控制中心（阶段 3b，plan.md P1-1 #3）：可调整大小的独立普通窗口（标准窗口 chrome、
      任务栏可见、关窗=Hide 复用不销毁、尺寸位置记入 AppConfig）。
      结构：左侧竖向导航（六分区，选中态用 Token 画刷）+ 右侧内容区（单页滚动）。
      窗口级引用 Tokens/Styles 现有资源；全部状态经 AppState 快照订阅（九态 + validity），
      写操作共用 AppState.RunWriteCommandAsync 通道（乐观更新 + 失败回滚与面板一致）。
      玻璃拟态（2026-10-31）：主窗口 Mica（BackdropService，Main 档）——窗口背景透明，
      导航栏与内容卡片用玻璃画刷，卡片间沟槽透出系统背景板；控件层保持不透明。
    -->
    <Window.Resources>
        <!-- 小节大标题 -->
        <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Title}"/>
            <Setter Property="LineHeight" Value="{StaticResource Font/Line.Title}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 内容卡片（玻璃化：半透明白 + 发丝描边，浮在 Mica 上） -->
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Brush/Glass.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush/Glass.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadius/Card}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing/Card.Padding}"/>
        </Style>

        <!-- 大号数值（电量 / 降噪模式） -->
        <Style x:Key="BigValueText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Display}"/>
            <Setter Property="LineHeight" Value="{StaticResource Font/Line.Display}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
        </Style>

        <!-- 辅助说明文字（多行） -->
        <Style x:Key="NoteText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Tertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 交互行禁用时整体降透明度（与快捷面板同语义） -->
        <Style x:Key="InteractiveRow" TargetType="{x:Type Grid}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 连接页信息行：左标签 + 右值 -->
        <Style x:Key="InfoRowLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Tertiary}"/>
        </Style>
        <Style x:Key="InfoRowValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Body}"/>
            <Setter Property="LineHeight" Value="{StaticResource Font/Line.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 左侧导航项：图标 + 文字；选中 = Surface.Hover 底 + Accent 左侧指示条 + Accent 文字 -->
        <Style x:Key="NavRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font/Primary}"/>
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Subtitle}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource CornerRadius/Control}"
                                Padding="10,9">
                            <Grid>
                                <Rectangle x:Name="Indicator"
                                           Width="3"
                                           Fill="{StaticResource Brush/Accent}"
                                           HorizontalAlignment="Left"
                                           Margin="-10,0,8,0"
                                           Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Font/Icon}"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="{StaticResource Font/Size.Subtitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <ContentPresenter x:Name="Content"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Surface.Hover}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Surface.Hover}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush/Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid TextElement.FontFamily="{StaticResource Font/Primary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ 左侧导航（玻璃栏：半透明白 + 玻璃发丝右描边） ═══════════════ -->
        <Border Background="{StaticResource Brush/Glass.Card}"
                BorderBrush="{StaticResource Brush/Glass.Hairline}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="{StaticResource Spacing/Card.Padding}">
                <TextBlock Text="QCY H3"
                           FontSize="{StaticResource Font/Size.Subtitle}"
                           LineHeight="{StaticResource Font/Line.Subtitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush/Text.Primary}"/>
                <TextBlock Text="控制中心"
                           FontSize="{StaticResource Font/Size.Caption}"
                           LineHeight="{StaticResource Font/Line.Caption}"
                           Foreground="{StaticResource Brush/Text.Tertiary}"/>
                <StackPanel Margin="0,16,0,0">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE80F;" Content="概览" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavNoise" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE767;" Content="降噪" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSound" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE9E9;" Content="声音" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavFeature" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE7FC;" Content="功能" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavConnection" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE702;" Content="连接" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="ccNav"
                                 Tag="&#xE713;" Content="设置" Checked="OnNavChecked"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ 右侧内容（单页滚动，一次只显示一个分区） ═══════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- ─────────────── 1. 概览 ─────────────── -->
                <Grid x:Name="OverviewSection">
                    <StackPanel>
                        <TextBlock Text="设备概览" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="耳机状态与常用操作，所有数值均来自设备实时回读"
                                   Style="{StaticResource NoteText}"
                                   Margin="0,-6,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                        <!-- 3D 耳机展示位：资源缺失整块折叠（同面板，高度 128） -->
                        <Border x:Name="HeadphoneHero"
                                Grid.Column="0"
                                CornerRadius="{StaticResource CornerRadius/Card}"
                                Background="{StaticResource Brush/Surface.Subtle}"
                                BorderBrush="{StaticResource Brush/Border.Subtle}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Height="{StaticResource Size/Hero.Height.ControlCenter}"
                                Margin="0,0,16,0"
                                Visibility="Collapsed">
                            <Image x:Name="HeadphoneHeroImage" Stretch="Uniform" MaxHeight="{StaticResource Size/Hero.Height.ControlCenter}"/>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OverviewDeviceName"
                                               Text="QCY H3"
                                               FontSize="{StaticResource Font/Size.Subtitle}"
                                               LineHeight="{StaticResource Font/Line.Subtitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush/Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewStatusText"
                                               Grid.Column="1"
                                               Text="未连接"
                                               FontSize="{StaticResource Font/Size.Body}"
                                               LineHeight="{StaticResource Font/Line.Body}"
                                               VerticalAlignment="Center"
                                               ToolTipService.InitialShowDelay="100"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="电量" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <TextBlock x:Name="OverviewBatteryText" Text="--" Style="{StaticResource BigValueText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="降噪模式" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <TextBlock x:Name="OverviewNoiseModeText" Text="--" Style="{StaticResource BigValueText}"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,14,0,14" Background="{StaticResource Brush/Border.Subtle}"/>

                                <Grid x:Name="OverviewGameModeRow" Style="{StaticResource InteractiveRow}">
                                    <StackPanel>
                                        <TextBlock Text="游戏模式"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="开启后耳机进入低延迟模式（可能增加功耗）。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="OverviewGameModeSwitch"
                                                  Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="OnGameModeChanged" Unchecked="OnGameModeChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="OverviewReconnectButton" Style="{StaticResource SecondaryButton}"
                                            Content="立即重连" Click="OnReconnectClick"/>
                                    <Button x:Name="OverviewDisconnectButton" Style="{StaticResource SecondaryButton}"
                                            Foreground="{StaticResource Brush/Danger}"
                                            Content="断开" Margin="{StaticResource Spacing/Gap}" Click="OnDisconnectClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ─────────────── 2. 降噪 ─────────────── -->
                <Grid x:Name="NoiseSection" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="噪声控制" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="NoiseSectionRoot">
                                <TextBlock Text="模式" Style="{StaticResource SectionLabel}"/>
                                <Border Height="44"
                                        CornerRadius="{StaticResource CornerRadius/Control}"
                                        Background="{StaticResource Brush/Segment.Track}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="NoiseThumb"
                                                Width="56"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Margin="{StaticResource Spacing/Segment.ThumbInset}"
                                                CornerRadius="{StaticResource CornerRadius/Small}"
                                                Background="{StaticResource Brush/Segment.Thumb}"
                                                IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="NoiseThumbShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid x:Name="NoiseSegmentGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="SegOff" Style="{StaticResource SegmentRadioButton}"
                                                         GroupName="ccNoiseSegment" Content="关闭" Checked="OnSegmentChecked"/>
                                            <RadioButton x:Name="SegTransparency" Grid.Column="1" Style="{StaticResource SegmentRadioButton}"
                                                         GroupName="ccNoiseSegment" Content="通透" Checked="OnSegmentChecked"/>
                                            <RadioButton x:Name="SegNoiseCancelling" Grid.Column="2" Style="{StaticResource SegmentRadioButton}"
                                                         GroupName="ccNoiseSegment" Content="降噪" Checked="OnSegmentChecked"/>
                                            <RadioButton x:Name="SegAdaptive" Grid.Column="3" Style="{StaticResource SegmentRadioButton}"
                                                         GroupName="ccNoiseSegment" Content="自适应" Checked="OnSegmentChecked"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 等级（低/中/高）与场景（通勤/室内/抗风） -->
                                <StackPanel x:Name="NoiseSubRow" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="降噪档位" Style="{StaticResource SectionLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LevelLow" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseLevel"
                                                     Content="低" Checked="OnLevelChecked"/>
                                        <RadioButton x:Name="LevelMedium" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseLevel"
                                                     Content="中" Margin="{StaticResource Spacing/Gap}" Checked="OnLevelChecked"/>
                                        <RadioButton x:Name="LevelHigh" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseLevel"
                                                     Content="高" Margin="{StaticResource Spacing/Gap}" Checked="OnLevelChecked"/>
                                    </StackPanel>
                                    <TextBlock Text="场景模式（与降噪共享降噪段）" Style="{StaticResource SectionLabel}" Margin="0,10,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SceneCommuting" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseScene"
                                                     Content="通勤" Checked="OnSceneChecked"/>
                                        <RadioButton x:Name="SceneIndoor" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseScene"
                                                     Content="室内" Margin="{StaticResource Spacing/Gap}" Checked="OnSceneChecked"/>
                                        <RadioButton x:Name="SceneAntiWind" Style="{StaticResource PresetChipSmall}" GroupName="ccNoiseScene"
                                                     Content="抗风" Margin="{StaticResource Spacing/Gap}" Checked="OnSceneChecked"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="NoiseDescribeText"
                                           Style="{StaticResource NoteText}" Margin="0,12,0,0"
                                           Text="尚未读取到当前降噪模式。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ─────────────── 3. 声音 ─────────────── -->
                <Grid x:Name="SoundSection" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="声音" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="均衡器预设" Style="{StaticResource SectionLabel}"/>
                                <WrapPanel x:Name="EqChipsPanel" ItemWidth="{StaticResource Size/EqChip.Width}">
                                    <WrapPanel.Style>
                                        <Style TargetType="{x:Type WrapPanel}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <RadioButton x:Name="EqPresetDefault" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="默认" Tag="1" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqPresetPop" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="流行" Tag="2" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqPresetHeavyBass" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="重低音" Tag="3" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqPresetRock" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="摇滚" Tag="4" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqPresetSoft" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="柔和" Tag="5" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqPresetClassic" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="古典" Tag="6" Checked="OnEqPresetChecked"/>
                                    <RadioButton x:Name="EqCustomChip" Style="{StaticResource PresetChip}" GroupName="ccEqPreset"
                                                 Content="自定义" Checked="OnEqCustomChecked"/>
                                </WrapPanel>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="总增益（耳机当前值）" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <TextBlock x:Name="EqMasterGainText" Text="--" Style="{StaticResource BigValueText}"/>
                                    </StackPanel>
                                    <Button x:Name="OpenEqEditorButton" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Click="OnOpenEqEditorClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource Font/Icon}" Text="&#xE9E9;"
                                                       FontSize="{StaticResource Font/Size.Body}" VerticalAlignment="Center"/>
                                            <TextBlock Text="打开均衡器编辑器" Margin="{StaticResource Spacing/Gap}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ─────────────── 4. 功能 ─────────────── -->
                <Grid x:Name="FeatureSection" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="功能" Style="{StaticResource SectionHeader}"/>

                        <!-- 游戏模式（与概览页同源同步） -->
                        <Border Style="{StaticResource Card}">
                            <Grid x:Name="FeatureGameModeRow" Style="{StaticResource InteractiveRow}">
                                <StackPanel>
                                    <TextBlock Text="游戏模式"
                                               FontSize="{StaticResource Font/Size.Body}"
                                               LineHeight="{StaticResource Font/Line.Body}"
                                               Foreground="{StaticResource Brush/Text.Primary}"/>
                                    <TextBlock Text="开启后耳机进入低延迟模式（可能增加功耗）。与概览页开关同步。"
                                               Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="FeatureGameModeSwitch"
                                              Style="{StaticResource SwitchToggleButton}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="OnGameModeChanged" Unchecked="OnGameModeChanged"/>
                            </Grid>
                        </Border>

                        <!-- 自动关机（cmd 0x14 真机验证：读→写→回读全通；选择即写） -->
                        <TextBlock Text="自动关机" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid x:Name="AutoOffRow" Style="{StaticResource InteractiveRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动关机"
                                               FontSize="{StaticResource Font/Size.Body}"
                                               LineHeight="{StaticResource Font/Line.Body}"
                                               Foreground="{StaticResource Brush/Text.Primary}"/>
                                    <TextBlock Text="耳机无操作超过该时长后自动关机；「不自动关机」保持常开。选择后立即写入耳机。"
                                               Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="AutoOffStateText" Style="{StaticResource NoteText}" Margin="0,2,0,0"
                                               Text="" Visibility="Collapsed"/>
                                </StackPanel>
                                <ComboBox x:Name="AutoOffCombo" Grid.Column="1" MinWidth="140"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="Label" SelectedValuePath="Minutes"
                                          SelectionChanged="OnAutoOffSelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- 按键自定义 / 查找耳机 / 播放提示音 -->
                        <TextBlock Text="按键与音效" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="按键自定义"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="自定义各按键单击/双击/长按对应的功能；出厂配置只读展示，保存时整表写回。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="OpenKeyMapEditorButton" Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Content="打开按键编辑器" Click="OnOpenKeyMapEditorClick"/>
                                </Grid>

                                <Separator Margin="0,12,0,12" Background="{StaticResource Brush/Border.Subtle}"/>

                                <Grid x:Name="FindEarbudsRow" Style="{StaticResource InteractiveRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="查找耳机"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="耳机以当前音量响铃，帮助定位。点击后会先弹出确认。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="FindEarbudsButton" Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Content="查找耳机" Click="OnFindEarbudsClick"/>
                                </Grid>

                                <Separator Margin="0,12,0,12" Background="{StaticResource Brush/Border.Subtle}"/>

                                <Grid x:Name="PlayToneRow" Style="{StaticResource InteractiveRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="播放提示音"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="耳机外放一段提示音。点击后会先弹出确认。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PlayToneButton" Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Content="播放提示音" Click="OnPlayToneClick"/>
                                </Grid>

                                <TextBlock x:Name="FeatureHintText" Style="{StaticResource NoteText}"
                                           Margin="0,10,0,0" Text=""/>
                            </StackPanel>
                        </Border>

                        <!-- 双设备连接：真机读回空、无写命令出处——只放说明，不做开关 -->
                        <TextBlock Text="双设备连接" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="双设备连接"
                                               FontSize="{StaticResource Font/Size.Body}"
                                               LineHeight="{StaticResource Font/Line.Body}"
                                               Foreground="{StaticResource Brush/Text.Primary}"/>
                                    <TextBlock Text="由手机 QCY App 管理" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Brush/Text.Tertiary}"
                                               FontSize="{StaticResource Font/Size.Caption}" LineHeight="{StaticResource Font/Line.Caption}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource NoteText}" Margin="0,6,0,0"
                                           Text="双设备连接由手机 QCY App 管理：当前固件不支持通过第三方工具读写该设置。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ─────────────── 5. 连接 ─────────────── -->
                <Grid x:Name="ConnectionSection" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="连接" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="当前设备" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="名称" Style="{StaticResource InfoRowLabel}"/>
                                    <TextBlock x:Name="ConnectionDeviceName" Text="--" Style="{StaticResource InfoRowValue}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="蓝牙地址" Style="{StaticResource InfoRowLabel}"/>
                                    <TextBlock x:Name="ConnectionDeviceAddress" Text="--" Style="{StaticResource InfoRowValue}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="首次连接时间" Style="{StaticResource InfoRowLabel}"/>
                                    <TextBlock x:Name="ConnectionFirstConnected" Text="尚未连接过" Style="{StaticResource InfoRowValue}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="SwitchDeviceButton" Style="{StaticResource SecondaryButton}"
                                            Content="切换设备" Click="OnSwitchDeviceClick"/>
                                    <Button x:Name="ConnectionReconnectButton" Style="{StaticResource SecondaryButton}"
                                            Content="立即重连" Margin="{StaticResource Spacing/Gap}" Click="OnReconnectClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource NoteText}" Margin="0,12,0,0"
                                   Text="连接断开后自动重连：首次至少等待 2 秒（Windows 对刚断开的链路有冷却），之后按 1 / 5 / 30 秒退避；若系统拒绝访问则等待 5 秒再试。耳机不可达（关机、入盒或超范围）时持续监听广播，耳机开机后自动恢复连接。蓝牙关闭时会显示「蓝牙不可用」，蓝牙恢复后自动重连。"/>
                    </StackPanel>
                </Grid>

                <!-- ─────────────── 6. 设置 ─────────────── -->
                <Grid x:Name="SettingsSection" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="开机自启"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="登录 Windows 后自动运行（写入当前用户注册表 Run 键）。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AutostartSwitch"
                                                  Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
                                </Grid>
                                <TextBlock Style="{StaticResource NoteText}" Margin="0,12,0,0"
                                           Text="启动时静默后台：应用常驻系统托盘，不弹出窗口；检测到耳机后自动连接并同步状态。"/>
                            </StackPanel>
                        </Border>

                        <!-- 阶段 6：桌面通知（开关 + 低电量阈值档位；与托盘菜单无需同步） -->
                        <TextBlock Text="通知" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="桌面通知"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="通过系统托盘气泡推送提醒（Windows 10 及以上呈现为系统通知）。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="NotificationsSwitch"
                                                  Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged"/>
                                </Grid>

                                <Separator Margin="0,12,0,12" Background="{StaticResource Brush/Border.Subtle}"/>

                                <Grid x:Name="LowBatteryThresholdRow" Style="{StaticResource InteractiveRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="低电量提醒阈值"
                                                   FontSize="{StaticResource Font/Size.Body}"
                                                   LineHeight="{StaticResource Font/Line.Body}"
                                                   Foreground="{StaticResource Brush/Text.Primary}"/>
                                        <TextBlock Text="电量不高于该值时提醒一次；恢复到阈值 +10% 以上或重新连接后可再次提醒。"
                                                   Style="{StaticResource NoteText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="LowBatteryThresholdCombo" Grid.Column="1" MinWidth="110"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Percent"
                                              SelectionChanged="OnLowBatteryThresholdChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="关于" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="版本" Style="{StaticResource InfoRowLabel}"/>
                                    <TextBlock x:Name="AboutVersionText" Text="--" Style="{StaticResource InfoRowValue}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource NoteText}" Margin="0,10,0,0">
                                    <Run>项目地址：</Run>
                                    <Hyperlink NavigateUri="https://github.com/Soonkeira/QCYH3-HeadphonesController"
                                               RequestNavigate="OnProjectLinkNavigate">github.com/Soonkeira/QCYH3-HeadphonesController</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource NoteText}" Margin="0,6,0,0"
                                           Text="开源致谢：H.NotifyIcon（系统托盘）、.NET 8 / WPF；协议逆向参考 qcy-h3-controller（Python）、Quicky（Go）等开源项目。"/>
                                <TextBlock Style="{StaticResource NoteText}" Margin="0,6,0,0"
                                           Text="协议来源：BLE RCSP（杰理 JieLi 芯片私有协议），经真机抓包与开源参考实现逆向验证；UI 仅提供真机验证过的读写通道。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="诊断" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="诊断信息" FontSize="{StaticResource Font/Size.Body}"
                                           Foreground="{StaticResource Brush/Text.Primary}"/>
                            </Expander.Header>
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="连接状态" Style="{StaticResource InfoRowLabel}"/>
                                        <TextBlock x:Name="DiagStateText" Text="--" Style="{StaticResource InfoRowValue}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="状态详情" Style="{StaticResource InfoRowLabel}"/>
                                        <TextBlock x:Name="DiagStatusText" Text="--" Style="{StaticResource InfoRowValue}"/>
                                    </Grid>
                                    <TextBlock x:Name="DiagValidityText" Style="{StaticResource NoteText}" Margin="0,10,0,0" Text="--"/>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="日志文件" Style="{StaticResource InfoRowLabel}"/>
                                        <Button x:Name="OpenLogFolderButton" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" ToolTip="打开日志文件夹" Click="OnOpenLogFolderClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource Font/Icon}" Text="&#xE838;"
                                                           FontSize="{StaticResource Font/Size.Body}" VerticalAlignment="Center"/>
                                                <TextBlock Text="打开日志文件夹" FontSize="{StaticResource Font/Size.Caption}"
                                                           Margin="{StaticResource Spacing/Gap}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="DiagLogPathText" Style="{StaticResource NoteText}" Margin="0,4,0,0" Text="--"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
