<Window x:Class="QcyH3Tray.App.DevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择耳机设备"
        Width="440"
        Height="430"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="Transparent"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <!-- 玻璃拟态（2026-10-31）：圆角玻璃卡片浮在 Acrylic 上（列表 + 小字号文本，Strong 版保对比度） -->
    <Window.Resources>
        <Style x:Key="GlassDeviceItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius/Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Glass.ControlHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Glass.Edge}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush/Glass.NavSelected}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush/Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4"
                Background="{StaticResource Brush/Glass.FloatingSurface}"
                BorderBrush="{StaticResource Brush/Glass.Edge}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadius/Card}"
                Padding="6"
                Margin="-12"
                Effect="{StaticResource Effect/Glass.CardElevation}"/>

        <TextBlock Text="选择要控制的 QCY H3 耳机：扫描 6 秒后从列表中选择，然后点击「确定」。"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#555555"/>

        <ListBox x:Name="DeviceList"
                 Grid.Row="1"
                 Margin="0,12,0,0"
                 SelectionMode="Single"
                 ItemContainerStyle="{StaticResource GlassDeviceItem}"
                 Background="#55FFFFFF"
                 BorderBrush="{StaticResource Brush/Glass.Edge}"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnDeviceSelectionChanged"
                 MouseDoubleClick="OnDeviceDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreferred}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AddressText}" FontSize="11" Foreground="#999999"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RssiText}"
                                   FontSize="11"
                                   Foreground="#999999"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#8A8A8A"
                   Text="尚未选择目标设备。点击「扫描」搜索附近的耳机。"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}" Content="扫描" MinWidth="76" Click="OnScanClick"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="确定" MinWidth="76" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnConfirmClick" FontWeight="Bold"/>
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="76" Margin="8,0,0,0" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
