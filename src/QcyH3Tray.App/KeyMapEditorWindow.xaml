<Window x:Class="QcyH3Tray.App.KeyMapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按键自定义编辑器"
        Width="720"
        Height="600"
        MinWidth="660"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush/Surface}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <!--
      按键自定义编辑器（阶段 4b）：按 keyNum 分组的卡片（每组 单击/双击/三击/四击/长按 5 行，
      ComboBox 选功能）→ 出厂槽折叠区（action≥0x81 只读展示）→ 读自耳机 / 保存到耳机。
      数据源 = DeviceData.KeyMap 原始整表（GetKeyMappingsAsync）；保存 = 编辑差异 → 整表
      SetKeyMappingsAsync（Core 写后回读确认 + 乐观快照）。铁律：整表或全不写，出厂槽绝不改写
      （守卫在 KeyMapEditorSupport）。未保存修改（dirty）关窗三选：保存并关闭 / 放弃 / 取消。
    -->
    <Window.Resources>
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Brush/Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush/Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadius/Card}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing/Card.Padding}"/>
        </Style>

        <Style x:Key="NoteText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Tertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 编辑区禁用时整体降透明度（同 EQ 编辑器语义） -->
        <Style x:Key="DisabledFade" TargetType="{x:Type Grid}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity/Disabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 按键卡片标题 -->
        <Style x:Key="KeyTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource Font/Size.Subtitle}"/>
            <Setter Property="LineHeight" Value="{StaticResource Font/Line.Subtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush/Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18" TextElement.FontFamily="{StaticResource Font/Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ───────── 1. 说明 ───────── -->
        <TextBlock Style="{StaticResource NoteText}"
                   Text="按物理键编号分组（固件未公开按键的物理位置，请以耳机实际按键为准）；出厂配置只读展示。保存时整表写回耳机：未在编辑器中出现的行保持原值，绝不会丢失。"/>

        <!-- ───────── 2. 编辑区（按键卡片 + 出厂槽折叠区；代码生成） ───────── -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorArea">
                <StackPanel x:Name="KeysPanel"/>
                <Expander x:Name="FactoryExpander" Margin="0,10,0,0" Visibility="Collapsed" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock x:Name="FactoryHeaderText" Text="出厂配置（只读）"
                                   FontSize="{StaticResource Font/Size.Body}"
                                   Foreground="{StaticResource Brush/Text.Secondary}"/>
                    </Expander.Header>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" IsEnabled="False">
                        <StackPanel x:Name="FactoryPanel"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── 3. 设备操作按钮 ───────── -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ReadButton" Style="{StaticResource SecondaryButton}"
                    Content="读自耳机" HorizontalAlignment="Left" Click="OnReadClick"/>
            <Button x:Name="SaveButton" Style="{StaticResource AccentButton}"
                    Content="保存到耳机" HorizontalAlignment="Right" Click="OnSaveClick"/>
        </Grid>

        <!-- ───────── 4. 状态提示 ───────── -->
        <TextBlock x:Name="HintTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Style="{StaticResource NoteText}"
                   Text="正在读取耳机按键配置…"/>
    </Grid>
</Window>
